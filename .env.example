# Postgres connection string. On Vercel this is added for you when you connect a Neon database
# (Storage tab). Leave unset locally to use a built-in database stored in .data/.
DATABASE_URL=

# One-time code for creating the first admin at /setup. Pick a long random value; you can
# remove it once the admin exists.
SETUP_TOKEN=

# Set to "true" to fill an empty database with the fictional demo portfolio and demo accounts.
# Never use with real founder data: the demo passwords are public.
SEED_DEMO=

# Optional: the address people use to reach the app (e.g. https://kpis.yourfund.com), used in
# invite and request links. Defaults to the address the admin is viewing the app at.
APP_URL=
